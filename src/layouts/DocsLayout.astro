---
import type { MarkdownHeading } from "astro";
import BaseLayout from "./BaseLayout.astro";
import Icon from "../components/Icon.astro";
import { docHref, getDocs, groupDocs, type Doc } from "../lib/docs";
import { site } from "../lib/site";

interface Props {
  doc: Doc;
  headings: MarkdownHeading[];
}

const { doc, headings } = Astro.props;
const docs = await getDocs();
const groups = groupDocs(docs);
const position = docs.findIndex((entry) => entry.id === doc.id);
const prev = docs[position - 1];
const next = docs[position + 1];
const toc = headings.filter((heading) => heading.depth === 2);
const current = docHref(doc);
const editUrl = `${site.websiteRepo}/edit/main/src/content/docs/${doc.id}.md`;
---

<BaseLayout title={doc.data.title} description={doc.data.description}>
  <div class="container docs">
    <aside class="sidebar">
      <details class="menu" open>
        <summary>
          <Icon name="list" size={18} />
          <span>{doc.data.title}</span>
        </summary>
        <nav aria-label="Documentation">
          {
            groups.map((group) => (
              <div class="group">
                <h2>{group.section}</h2>
                <ul>
                  {group.docs.map((entry) => (
                    <li>
                      <a href={docHref(entry)} aria-current={docHref(entry) === current ? "page" : undefined}>
                        {entry.data.title}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            ))
          }
        </nav>
      </details>
    </aside>

    <article class="article">
      <header class="doc-head">
        <p class="section-name chip chip-wash" data-remix-tone="blue">{doc.data.section}</p>
        <h1>{doc.data.title}</h1>
        <p class="description">{doc.data.description}</p>
      </header>
      <div class="prose">
        <slot />
      </div>
      <footer class="doc-foot">
        <nav class="pager" aria-label="Previous and next page">
          {
            prev ? (
              <a class="prev" href={docHref(prev)}>
                <span>Previous</span>
                <strong>
                  <Icon name="arrow-left" size={16} />
                  {prev.data.title}
                </strong>
              </a>
            ) : (
              <span />
            )
          }
          {
            next ? (
              <a class="next" href={docHref(next)}>
                <span>Next</span>
                <strong>
                  {next.data.title}
                  <Icon name="arrow-right" size={16} />
                </strong>
              </a>
            ) : null
          }
        </nav>
        <a class="edit" href={editUrl}>
          <Icon name="pencil-simple" size={16} />
          Edit this page on GitHub
        </a>
      </footer>
    </article>

    <aside class="toc">
      {
        toc.length > 1 ? (
          <nav aria-label="On this page">
            <h2>On this page</h2>
            <ul>
              {toc.map((heading) => (
                <li>
                  <a href={`#${heading.slug}`}>{heading.text}</a>
                </li>
              ))}
            </ul>
          </nav>
        ) : null
      }
    </aside>
  </div>
</BaseLayout>

<script>
  // The sidebar is a disclosure only on small screens; keep it open on wide ones.
  const menu = document.querySelector<HTMLDetailsElement>(".menu");
  const wide = window.matchMedia("(min-width: 900px)");
  const sync = () => {
    if (menu) menu.open = wide.matches;
  };
  sync();
  wide.addEventListener("change", sync);
</script>

<style>
  .docs {
    display: grid;
    grid-template-columns: 232px minmax(0, 1fr) 200px;
    gap: 48px;
    align-items: start;
    padding-block: 32px 0;
  }

  .sidebar,
  .toc {
    position: sticky;
    top: calc(var(--nav-h) + 32px);
    max-height: calc(100dvh - var(--nav-h) - 48px);
    overflow-y: auto;
    scrollbar-width: thin;
  }

  .menu summary {
    display: none;
  }

  .group + .group {
    margin-top: 28px;
  }

  .group h2,
  .toc h2 {
    margin: 0 0 8px;
    color: var(--remix-text);
    font-size: 13px;
    font-weight: 650;
  }

  .group ul,
  .toc ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .group a {
    display: block;
    padding: 5px 12px;
    margin-left: -12px;
    border-radius: var(--remix-button-radius);
    color: var(--remix-text-muted);
    font-size: 14.5px;
    line-height: 1.4;
    text-decoration: none;
  }

  .group a:hover {
    color: var(--remix-text);
    background: var(--remix-surface);
  }

  /* The current page reads like the app's active tab. */
  .group a[aria-current="page"] {
    color: #ffffff;
    background: var(--fill-blue);
    font-weight: 600;
  }

  .toc a {
    display: block;
    padding: 4px 0;
    color: var(--remix-text-muted);
    font-size: 13.5px;
    line-height: 1.4;
    text-decoration: none;
  }

  .toc a:hover {
    color: var(--remix-text);
  }

  .article {
    max-width: 800px;
    min-width: 0;
    padding: clamp(20px, 4vw, 40px);
    border: 1px solid var(--remix-card-line);
    border-radius: var(--remix-shell-radius);
    background: var(--remix-surface);
    box-shadow: var(--remix-card-lift);
  }

  .doc-head {
    padding-bottom: 28px;
    margin-bottom: 8px;
    border-bottom: 1px solid var(--remix-card-line);
  }

  .section-name {
    margin: 0 0 12px;
  }

  .doc-head h1 {
    margin: 0 0 12px;
    font-size: clamp(2rem, 4vw, 2.7rem);
    font-weight: 720;
    line-height: 1.1;
    letter-spacing: -0.035em;
  }

  .description {
    margin: 0;
    color: var(--remix-text-muted);
    font-size: 1.1rem;
  }

  .doc-foot {
    margin-top: 64px;
    padding-top: 28px;
    border-top: 1px solid var(--remix-card-line);
  }

  .pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px;
  }

  .pager a {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 14px 18px;
    border: 1px solid var(--remix-card-line);
    border-radius: var(--remix-card-radius);
    box-shadow: var(--remix-card-lift);
    text-decoration: none;
    transition: background-color 140ms ease;
  }

  .pager a:hover {
    background: var(--remix-paper-hover);
  }

  .pager span {
    color: var(--remix-text-muted);
    font-size: 13px;
  }

  .pager strong {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-weight: 600;
  }

  .pager .next {
    grid-column: 2;
    align-items: flex-end;
    text-align: right;
  }

  .edit {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: 24px;
    color: var(--remix-text-muted);
    font-size: 14px;
    text-decoration: none;
  }

  .edit:hover {
    color: var(--link);
  }

  /* Prose */
  .prose {
    font-size: 16.5px;
    line-height: 1.72;
  }

  .prose :global(h2) {
    margin: 52px 0 14px;
    font-size: 1.55rem;
    font-weight: 680;
    line-height: 1.25;
    letter-spacing: -0.02em;
  }

  .prose :global(h3) {
    margin: 36px 0 10px;
    font-size: 1.18rem;
    font-weight: 650;
    letter-spacing: -0.01em;
  }

  .prose :global(p),
  .prose :global(ul),
  .prose :global(ol) {
    margin: 0 0 18px;
  }

  .prose :global(p),
  .prose :global(li) {
    color: color-mix(in oklab, var(--remix-text) 88%, var(--remix-surface));
  }

  .prose :global(ul),
  .prose :global(ol) {
    padding-left: 22px;
  }

  .prose :global(li) {
    margin-bottom: 8px;
  }

  .prose :global(li::marker) {
    color: var(--remix-blue);
  }

  .prose :global(strong) {
    color: var(--remix-text);
    font-weight: 620;
  }

  .prose :global(a) {
    color: var(--link);
    text-decoration: underline;
    text-decoration-color: color-mix(in oklab, var(--link) 40%, transparent);
    text-underline-offset: 3px;
  }

  .prose :global(a:hover) {
    text-decoration-color: var(--link);
  }

  .prose :global(:not(pre) > code) {
    padding: 2px 6px;
    border: 1px solid var(--remix-card-line);
    border-radius: 6px;
    background: var(--remix-inset);
    color: var(--remix-text);
    font-size: 0.88em;
  }

  /* !important: Shiki sets its theme's background inline on each block. */
  .prose :global(pre) {
    margin: 0 0 22px;
    padding: 16px 18px;
    border: 1px solid var(--remix-card-line);
    border-radius: var(--remix-card-radius);
    background-color: var(--code-bg) !important;
    font-size: 14px;
    line-height: 1.6;
    overflow-x: auto;
  }

  .prose :global(blockquote) {
    margin: 0 0 22px;
    padding: 14px 18px;
    border: 1px solid var(--remix-card-line);
    border-radius: var(--remix-card-radius);
    background: color-mix(in oklab, var(--remix-yellow) 16%, var(--remix-surface));
  }

  .prose :global(blockquote p:last-child) {
    margin-bottom: 0;
  }

  .prose :global(table) {
    width: 100%;
    margin: 0 0 22px;
    border-collapse: collapse;
    font-size: 15px;
  }

  .prose :global(th),
  .prose :global(td) {
    padding: 10px 12px;
    border-bottom: 1px solid var(--remix-card-line);
    text-align: left;
    vertical-align: top;
  }

  .prose :global(td:first-child) {
    white-space: nowrap;
  }

  .prose :global(th) {
    background: var(--remix-inset);
    color: var(--remix-text);
    font-weight: 600;
  }

  .prose :global(td) {
    color: color-mix(in oklab, var(--remix-text) 88%, var(--remix-surface));
  }

  .prose :global(hr) {
    margin: 40px 0;
    border: 0;
    border-top: 1px solid var(--remix-card-line);
  }

  @media (max-width: 1180px) {
    .docs {
      grid-template-columns: 220px minmax(0, 1fr);
    }

    .toc {
      display: none;
    }
  }

  @media (max-width: 899px) {
    .docs {
      grid-template-columns: minmax(0, 1fr);
      gap: 24px;
      padding-top: 20px;
    }

    .sidebar {
      position: static;
      max-height: none;
      overflow: visible;
    }

    .menu {
      border: 1px solid var(--remix-card-line);
      border-radius: var(--remix-card-radius);
      background: var(--remix-surface);
    }

    .menu summary {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 12px 16px;
      font-weight: 600;
      cursor: pointer;
      list-style: none;
    }

    .menu summary::-webkit-details-marker {
      display: none;
    }

    .menu nav {
      padding: 4px 16px 18px;
      border-top: 1px solid var(--remix-card-line);
    }

    .menu .group:first-child {
      margin-top: 16px;
    }

    .prose :global(table) {
      display: block;
      overflow-x: auto;
    }
  }
</style>
