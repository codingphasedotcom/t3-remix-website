---
import Icon from "./Icon.astro";
import { site } from "../lib/site";

const path = Astro.url.pathname;
const inDocs = path.startsWith("/docs");
---

<header class="nav">
  <div class="container nav-inner">
    <a class="brand" href="/" aria-label="T3 Remix home">
      <img src="/icon-192.png" alt="" width="30" height="30" />
      <span>T3 Remix</span>
    </a>
    <nav class="links" aria-label="Main">
      <a href="/#features">Features</a>
      <a href="/docs/" aria-current={inDocs ? "page" : undefined}>Docs</a>
      <a href={site.repo} class="github">
        <Icon name="github-logo" size={18} />
        <span>GitHub</span>
      </a>
    </nav>
    <a class="btn btn-primary btn-sm download" href={site.releases}>
      <Icon name="apple-logo" weight="fill" size={16} />
      Download for Mac
    </a>
  </div>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    height: var(--nav-h);
    border-bottom: 1px solid var(--border);
    background: rgb(11 12 10 / 0.86);
    backdrop-filter: blur(12px) saturate(140%);
    -webkit-backdrop-filter: blur(12px) saturate(140%);
  }

  .nav-inner {
    display: flex;
    align-items: center;
    gap: 28px;
    height: 100%;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-weight: 700;
    font-size: 17px;
    letter-spacing: -0.02em;
    text-decoration: none;
  }

  .brand img {
    border-radius: 8px;
  }

  .links {
    display: flex;
    align-items: center;
    gap: 22px;
    margin-left: auto;
    font-size: 14.5px;
  }

  .links a {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--muted);
    text-decoration: none;
    transition: color 140ms ease;
  }

  .links a:hover,
  .links a[aria-current="page"] {
    color: var(--text);
  }

  @media (max-width: 720px) {
    .nav-inner {
      gap: 16px;
    }

    .links {
      gap: 16px;
    }

    .links .github span,
    .download {
      display: none;
    }
  }

  @media (max-width: 380px) {
    .links a[href="/#features"] {
      display: none;
    }
  }
</style>
