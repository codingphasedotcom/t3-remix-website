---
import Icon from "./Icon.astro";

// A small, faithful rendition of the app's Org chart tab: the Software team template under a CEO,
// plus a pending hire request, which the app pins to the top of the chart.
const tabs = ["Board", "Org chart", "Skills", "Routines", "Dashboard"];
---

<figure class="org remix-shell" data-remix-tone="blue" aria-label="The Org chart tab of a T3 Remix company">
  <div class="bar">
    <span class="company">Fernway</span>
    <div class="tabs" role="presentation">
      {tabs.map((tab) => <span class:list={["tab", { active: tab === "Org chart" }]}>{tab}</span>)}
    </div>
  </div>

  <div class="hire" data-remix-tone="yellow">
    <span class="icon-tile hire-icon"><Icon name="user-plus" size={16} /></span>
    <div class="hire-text">
      <strong>Security engineer</strong>
      <span>Engineering, requested by Grace</span>
    </div>
    <span class="hire-actions">
      <span class="fake-btn ghost">Decline</span>
      <span class="fake-btn">Hire</span>
    </span>
  </div>

  <div class="tree remix-well">
    <ul>
      <li>
        <div class="node ceo" data-remix-tone="yellow" style="--i:0">
          <span class="ring"><img class="face" src="/faces/vera.jpg" alt="" width="52" height="52" /></span>
          <span class="plate remix-card">
            <span class="band"></span>
            <strong>Vera</strong>
            <span class="role">CEO</span>
          </span>
        </div>
        <ul>
          <li>
            <div class="node" data-remix-tone="blue" style="--i:1">
              <span class="ring"><img class="face" src="/faces/grace.jpg" alt="" width="44" height="44" /></span>
              <span class="plate remix-card">
                <span class="band"></span>
                <strong>Grace</strong>
                <span class="role">CTO</span>
              </span>
            </div>
            <ul>
              <li>
                <div class="node" data-remix-tone="teal" style="--i:3">
                  <span class="ring"><img class="face" src="/faces/linus.jpg" alt="" width="44" height="44" /></span>
                  <span class="plate remix-card">
                    <span class="band"></span>
                    <strong>Linus</strong>
                    <span class="role">Engineer</span>
                  </span>
                </div>
              </li>
              <li>
                <div class="node" data-remix-tone="purple" style="--i:4">
                  <span class="ring"><img class="face" src="/faces/ada.jpg" alt="" width="44" height="44" /></span>
                  <span class="plate remix-card">
                    <span class="band"></span>
                    <strong>Ada</strong>
                    <span class="role">Frontend</span>
                    <span class="chip working" data-remix-tone="blue">Working</span>
                  </span>
                </div>
              </li>
              <li>
                <div class="node" data-remix-tone="green" style="--i:5">
                  <span class="ring"><img class="face" src="/faces/margaret.jpg" alt="" width="44" height="44" /></span>
                  <span class="plate remix-card">
                    <span class="band"></span>
                    <strong>Margaret</strong>
                    <span class="role">QA</span>
                  </span>
                </div>
              </li>
            </ul>
          </li>
          <li>
            <div class="node" data-remix-tone="pink" style="--i:2">
              <span class="ring"><img class="face" src="/faces/peggy.jpg" alt="" width="44" height="44" /></span>
              <span class="plate remix-card">
                <span class="band"></span>
                <strong>Peggy</strong>
                <span class="role">Marketing</span>
              </span>
            </div>
          </li>
        </ul>
      </li>
    </ul>
  </div>
</figure>

<style>
  .org {
    gap: 10px;
    margin: 0;
    padding: 10px;
    overflow: hidden;
  }

  .bar {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 2px 4px;
  }

  .company {
    font-size: 14px;
    font-weight: 650;
    letter-spacing: -0.01em;
  }

  .tabs {
    display: flex;
    gap: 4px;
    overflow: hidden;
    mask-image: linear-gradient(90deg, #000 85%, transparent);
  }

  .tab {
    padding: 4px 9px;
    border: 1px solid var(--remix-card-line);
    border-radius: var(--remix-button-radius);
    background: var(--remix-surface);
    color: var(--remix-text);
    font-size: 12px;
    font-weight: 600;
    white-space: nowrap;
  }

  .tab.active {
    background: var(--fill-blue);
    color: #ffffff;
  }

  .hire {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 8px 10px;
    border: 1px solid var(--remix-card-line);
    border-radius: var(--remix-well-radius);
    background: var(--tone-wash);
  }

  .hire-icon {
    width: 32px;
    height: 32px;
    border-radius: 10px;
  }

  .hire-text {
    display: flex;
    flex-direction: column;
    min-width: 0;
    line-height: 1.3;
  }

  .hire-text strong {
    font-size: 13.5px;
  }

  .hire-text span {
    color: var(--remix-text-muted);
    font-size: 12px;
  }

  .hire-actions {
    display: flex;
    gap: 6px;
    margin-left: auto;
  }

  .fake-btn {
    padding: 4px 11px;
    border: 1px solid var(--remix-card-line);
    border-radius: var(--remix-button-radius);
    background: var(--spray);
    color: var(--spray-ink);
    font-size: 12px;
    font-weight: 600;
  }

  .fake-btn.ghost {
    background: var(--remix-surface);
    color: var(--remix-text);
  }

  .tree {
    --line: color-mix(in oklab, var(--remix-text) 40%, transparent);
    display: block;
    padding: 18px 10px 20px;
  }

  .tree ul {
    position: relative;
    display: flex;
    justify-content: center;
    margin: 0;
    padding: 20px 0 0;
  }

  .tree > ul {
    padding-top: 0;
  }

  .tree li {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 20px 4px 0;
    list-style: none;
  }

  .tree li::before,
  .tree li::after {
    content: "";
    position: absolute;
    top: 0;
    right: 50%;
    width: 50%;
    height: 20px;
    border-top: 2px solid var(--line);
  }

  .tree li::after {
    right: auto;
    left: 50%;
    border-left: 2px solid var(--line);
  }

  .tree li:only-child {
    padding-top: 0;
  }

  .tree li:only-child::before,
  .tree li:only-child::after {
    display: none;
  }

  .tree li:first-child::before,
  .tree li:last-child::after {
    border: 0 none;
  }

  .tree li:last-child::before {
    border-right: 2px solid var(--line);
    border-radius: 0 10px 0 0;
  }

  .tree li:first-child::after {
    border-radius: 10px 0 0 0;
  }

  .tree ul ul::before {
    content: "";
    position: absolute;
    top: 0;
    left: 50%;
    height: 20px;
    border-left: 2px solid var(--line);
  }

  /* The app's person card: a round face sitting over a toned band on a white plate. */
  .node {
    position: relative;
    width: 90px;
    padding-top: 22px;
    text-align: center;
    line-height: 1.25;
  }

  .ring {
    position: absolute;
    z-index: 1;
    top: 0;
    left: 50%;
    display: block;
    padding: 3px;
    border: 1px solid var(--remix-card-line);
    border-radius: 999px;
    background: var(--tone);
    box-shadow: var(--remix-card-lift);
    transform: translateX(-50%);
  }

  .node .face {
    width: 40px;
    height: 40px;
  }

  .plate {
    align-items: center;
    padding-bottom: 8px;
    overflow: hidden;
    box-shadow: var(--remix-card-lift);
  }

  .band {
    align-self: stretch;
    height: 26px;
    margin-bottom: 16px;
    border-bottom: 1px solid var(--remix-card-line);
    background: var(--tone-shell);
  }

  .plate strong {
    font-size: 12.5px;
  }

  .role {
    color: var(--remix-text-muted);
    font-size: 11px;
  }

  .working {
    height: 18px;
    margin-top: 5px;
    padding: 0 6px;
    font-size: 10.5px;
  }

  .ceo {
    width: 112px;
    padding-top: 26px;
  }

  .ceo .face {
    width: 48px;
    height: 48px;
  }

  .ceo .band {
    height: 30px;
    margin-bottom: 20px;
  }

  @media (prefers-reduced-motion: no-preference) {
    .js .node {
      opacity: 0;
      transform: translateY(10px) scale(0.96);
      animation: node-in 520ms var(--ease-out) forwards;
      animation-delay: calc(500ms + var(--i) * 110ms);
    }

    .js .hire {
      opacity: 0;
      animation: node-in 520ms var(--ease-out) 1300ms forwards;
    }
  }

  @keyframes node-in {
    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (max-width: 520px) {
    .tree {
      padding-inline: 4px;
    }

    .tree li {
      padding-inline: 2px;
    }

    .node {
      width: 72px;
      padding-top: 18px;
    }

    .ceo {
      width: 88px;
    }

    .node .face {
      width: 32px;
      height: 32px;
    }

    .band {
      height: 20px;
      margin-bottom: 14px;
    }

    .plate strong {
      font-size: 11.5px;
    }

    .role {
      font-size: 10px;
    }

    .hire-text span {
      display: none;
    }
  }
</style>
