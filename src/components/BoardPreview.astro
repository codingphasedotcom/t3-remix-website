---
import Art, { type ArtName } from "./Art.astro";
import Icon from "./Icon.astro";

// Column names, hints, tones and art are the app's own (apps/web/src/components/board).
interface Card {
  title: string;
  who?: { name: string; face?: string };
  tag?: { label: string; icon?: string };
  // The app fills the card an agent is working on.
  live?: boolean;
}

const columns: { label: string; hint: string; tone: string; art: ArtName; cards: Card[] }[] = [
  {
    label: "Ideas",
    tone: "purple",
    art: "bulb",
    hint: "Waits for a human to schedule it.",
    cards: [{ title: "Usage-based pricing page" }],
  },
  {
    label: "To do",
    tone: "orange",
    art: "clipboard",
    hint: "Tasks with an assignee start automatically.",
    cards: [
      { title: "Regression tests for sign-up", who: { name: "Margaret", face: "margaret" } },
      { title: "Record the launch demo", who: { name: "You" }, tag: { label: "Your task" } },
    ],
  },
  {
    label: "In progress",
    tone: "blue",
    art: "gear",
    hint: "An agent is working the task.",
    cards: [
      {
        title: "Onboarding checklist UI",
        who: { name: "Ada", face: "ada" },
        tag: { label: "Subtask", icon: "tree-structure" },
        live: true,
      },
    ],
  },
  {
    label: "Review",
    tone: "yellow",
    art: "magnifier",
    hint: "The reviewer starts when one is set.",
    cards: [
      {
        title: "Seed data for new accounts",
        who: { name: "Linus", face: "linus" },
        tag: { label: "Grace reviews", icon: "eye" },
      },
    ],
  },
  {
    label: "Blocked",
    tone: "pink",
    art: "warning",
    hint: "Needs a decision or its subtasks.",
    cards: [
      {
        title: "Launch onboarding",
        who: { name: "Grace", face: "grace" },
        tag: { label: "2 of 3 subtasks done", icon: "tree-structure" },
      },
    ],
  },
  {
    label: "Done",
    tone: "green",
    art: "check",
    hint: "Approved work.",
    cards: [
      {
        title: "Release notes for 0.2",
        who: { name: "Mary", face: "mary" },
        tag: { label: "PR merged", icon: "git-merge" },
      },
    ],
  },
];
---

<figure class="board" aria-label="A T3 Remix board with its six columns">
  <div class="scroller">
    {
      columns.map((column, i) => (
        <section class="col remix-shell reveal" data-remix-tone={column.tone} style={`--i:${i}`}>
          <header>
            <h3 class="bubble bubble-sm">
              {column.label}: {column.cards.length}
            </h3>
            <Art name={column.art} class="col-art" />
          </header>
          <p class="hint">{column.hint}</p>
          <div class="well remix-well">
            {column.cards.map((card) => (
              <article
                class:list={["card remix-card", { live: card.live }]}
                data-remix-tone={card.live ? "blue" : undefined}
              >
                <p class="title">{card.title}</p>
                <div class="meta">
                  {card.who ? (
                    <span class="who">
                      {card.who.face ? (
                        <img class="face" src={`/faces/${card.who.face}.jpg`} alt="" width="22" height="22" />
                      ) : (
                        <span class="you">
                          <Icon name="user" size={13} />
                        </span>
                      )}
                      {card.who.name}
                    </span>
                  ) : (
                    <span class="who">Unassigned</span>
                  )}
                  {card.tag ? (
                    <span class="chip chip-wash" data-remix-tone={card.live ? "blue" : column.tone}>
                      {card.tag.icon ? <Icon name={card.tag.icon} size={12} /> : null}
                      {card.tag.label}
                    </span>
                  ) : null}
                </div>
              </article>
            ))}
          </div>
        </section>
      ))
    }
  </div>
</figure>

<style>
  .board {
    margin: 0;
  }

  /* The padding keeps the columns' soft shadows from clipping in the scroll area. */
  .scroller {
    display: grid;
    grid-template-columns: repeat(6, minmax(176px, 1fr));
    gap: 10px;
    padding: 2px 2px 6px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: thin;
    scrollbar-color: var(--remix-card-line) transparent;
  }

  .col {
    min-height: 268px;
    scroll-snap-align: start;
  }

  .col header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    padding: 10px 10px 8px;
  }

  .col :global(.col-art) {
    flex: none;
    width: 26px;
    height: 26px;
  }

  .hint {
    margin: 0;
    padding: 2px 12px 10px;
    color: var(--remix-text);
    font-size: 12px;
    line-height: 1.4;
    opacity: 0.8;
  }

  .well {
    flex: 1;
    gap: 8px;
    margin: 0 6px 6px;
    padding: 6px;
  }

  .card {
    gap: 8px;
    padding: 10px;
    border-color: var(--tone);
    box-shadow: var(--tone-lift);
  }

  .live {
    background: var(--tone);
    color: var(--tone-on);
    box-shadow: var(--remix-card-lift);
  }

  .title {
    margin: 0;
    font-size: 13.5px;
    font-weight: 600;
    line-height: 1.35;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 8px;
  }

  .who {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--remix-text-muted);
    font-size: 12px;
    font-weight: 500;
  }

  .live .who {
    color: var(--tone-on);
  }

  .who .face {
    width: 22px;
    height: 22px;
  }

  .you {
    display: grid;
    place-items: center;
    width: 22px;
    height: 22px;
    border-radius: 999px;
    border: 1px dashed var(--remix-text-muted);
  }

  @media (max-width: 760px) {
    .scroller {
      grid-template-columns: repeat(6, 78%);
    }
  }
</style>
